---
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface MenuItem {
    name: string;
    url: string;
    icon?: string;
    external?: boolean;
}

interface Props {
    name: string;
    icon?: string;
    items: MenuItem[];
}

const { name, icon, items } = Astro.props;
---

<div class="relative group">
    <!-- 顶部按钮 -->
    <button
        class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
        type="button"
    >
        <div class="flex items-center">
            {icon && (
                <Icon
                    name={icon}
                    class="text-[1.1rem] mr-2"
                />
            )}

            {name}

            <Icon
                name="material-symbols:keyboard-arrow-down-rounded"
                class="text-[1.25rem] ml-1 transition-transform duration-200 group-hover:rotate-180"
            />
        </div>
    </button>

    <!-- 下拉菜单 -->
    <div
        class="
            absolute
            top-full
            left-1/2
            -translate-x-1/2
            pt-2
            opacity-0
            invisible
            translate-y-1
            group-hover:opacity-100
            group-hover:visible
            group-hover:translate-y-0
            group-focus-within:opacity-100
            group-focus-within:visible
            group-focus-within:translate-y-0
            transition-all
            duration-200
            z-50
        "
    >
        <div
            class="
                card-base
                !overflow-visible
                min-w-[10rem]
                p-2
                shadow-lg
            "
        >
            {
                items.map((item) => (
                    <a
                        href={item.external ? item.url : url(item.url)}
                        target={item.external ? "_blank" : undefined}
                        class="
                            btn-plain
                            rounded-lg
                            h-10
                            px-3
                            flex
                            items-center
                            whitespace-nowrap
                            font-medium
                        "
                    >
                        {item.icon && (
                            <Icon
                                name={item.icon}
                                class="text-[1.2rem] mr-3"
                            />
                        )}

                        <span>{item.name}</span>

                        {item.external && (
                            <Icon
                                name="fa6-solid:arrow-up-right-from-square"
                                class="text-[0.7rem] ml-auto pl-3 opacity-30"
                            />
                        )}
                    </a>
                ))
            }
        </div>
    </div>
</div>